{
  "name": "cs2clean",
  "productName": "CS2Clean",
  "private": true,
  "version": "1.7.0",
  "description": "CS2Clean companion app and in-game overlay for CS2. Shows the evidence class of the players in your match.",
  "author": "CS2Clean",
  "homepage": "https://github.com/papelblume/cs2clean",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc --noEmit -p tsconfig.json && vite build && node tools/wayland/build.mjs",
    "start": "npm run build && electron .",
    "start:replay": "npm run build && electron . --replay",
    "start:overwolf": "npm run build && ow-electron . --overwolf",
    "coplay": "tsc -p tsconfig.main.json && node dist/main/steam/coplay-cli.js",
    "friends-ui": "tsc -p tsconfig.main.json && node dist/main/steam/friends-ui-cli.js",
    "console-status": "tsc -p tsconfig.main.json && node dist/main/steam/console-status-cli.js",
    "leetify:probe": "tsc -p tsconfig.main.json && node dist/main/leetify-cli.js",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "dist:zip": "npm run build && electron-builder --win zip --x64 -c.win.extraFiles.from=tools/portable -c.win.extraFiles.to=. -c.win.extraFiles.filter=portable.txt",
    "check:package": "electron-builder --linux dir --x64 && node tools/check-package.mjs release/linux-unpacked/resources/app.asar",
    "dev:ui": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "overwolf": {
    "packages": [
      "gep",
      "overlay"
    ]
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@overwolf/ow-electron": "^44.9.0",
    "@overwolf/ow-electron-packages-types": "^1.1.11",
    "@types/node": "^24.9.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "koffi": "^3.3.8",
    "lucide-react": "^1.73.0"
  },
  "build": {
    "appId": "eu.cs2clean.companion",
    "productName": "CS2Clean",
    "copyright": "CS2Clean",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json",
      "node_modules/koffi/**",
      "!**/*.map",
      "!dist/main/steam/coplay-cli.js",
      "!dist/main/steam/friends-ui-cli.js",
      "!dist/main/steam/console-status-cli.js",
      "!dist/main/leetify-cli.js",
      "!node_modules/koffi/doc/**",
      "!node_modules/koffi/vendor/**"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "dist/wayland-overlay"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "CS2Clean-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CS2Clean",
      "runAfterFinish": true,
      "artifactName": "CS2Clean-Setup-${version}.${ext}"
    },
    "publish": null,
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "description": "CS2Clean companion app and in-game overlay for CS2",
      "icon": "assets/icon.png"
    }
  },
  "allowScripts": {
    "koffi@3.3.8": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
